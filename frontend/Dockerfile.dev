FROM node:24-bookworm-slim

WORKDIR /app

RUN corepack enable && chown node:node /app

# 저장소 루트의 workspace lockfile로 웹과 공통 패키지만 설치합니다.
COPY --chown=node:node package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --chown=node:node frontend/package.json ./frontend/package.json
COPY --chown=node:node packages/shared/package.json ./packages/shared/package.json
COPY --chown=node:node mobile/package.json ./mobile/package.json

USER node

RUN pnpm --filter govbiz-web... install --frozen-lockfile

COPY --chown=node:node frontend ./frontend
COPY --chown=node:node packages/shared ./packages/shared

WORKDIR /app/frontend

EXPOSE 5173

CMD ["pnpm", "dev"]
